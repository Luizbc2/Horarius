COMPOSE_PROJECT_NAME=schedra

APP_HOST=schedra.app
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=schedra
MYSQL_USER=schedra
MYSQL_PASSWORD=change_app_password

BACKEND_PORT=3333
FRONTEND_URL=https://schedra.app
APP_TIMEZONE=America/Sao_Paulo
VITE_API_BASE_URL=/api

DB_DIALECT=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=schedra
DB_USER=schedra
DB_PASSWORD=change_app_password
DB_SSL=false
DB_AUTO_SYNC=true

AUTH_USER_NAME=Usuario Schedra
AUTH_USER_EMAIL=admin@schedra.com
AUTH_USER_CPF=52998224725
AUTH_USER_PASSWORD=change_seed_password
AUTH_SEED_ENABLED=false
JWT_SECRET=change_this_long_random_jwt_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
AUTH_RATE_LIMIT_MAX_REQUESTS=20
METRICS_TOKEN=change_this_private_metrics_token
